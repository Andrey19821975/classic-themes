.my-account-section {
	&:last-of-type {
		margin-bottom: 110px;
	}

	h1.title {
		@include text-style-text-headline-1;

		margin-bottom: 20px;
	}

	.woocommerce {
		@media (--lg) {
			display: flex;
			align-items: flex-start;
		}
	}

	.woocommerce-MyAccount-navigation {
		@extend .woocommerce-section;

		background: $woo-color-colors-element;
		padding: 40px 30px;
		margin-bottom: 2px;

		@media (--sm) {
			padding: 40px 50px 42px;
		}

		@media (--lg) {
			flex: 0 0 calc(300px - 30px);
			margin-right: 30px;
			position: sticky;
			top: 10px;
		}

		ul {
			list-style: none;
			padding: 0;
			margin: 0;
			counter-reset: item;

			li {
				@include text-style-text-text-main;

				color: $woo-color-text-main;
				transition: color 0.3s, text-shadow 0.3s;

				&.is-active {
					font-weight: 600;
					color: $woo-color-colors-main;
				}

				&:not(.is-active):--enter {
					color: $woo-color-colors-main;
					text-shadow: 0 0 0;
				}

				&::before {
					counter-increment: item;
					content: "0" counters(item, "") ". ";
					min-width: 23px;
				}

				a {
					color: inherit;

					&:--enter {
						text-decoration: none;
					}
				}
			}

			li + li {
				margin-top: 5px;
			}
		}
	}

	.woocommerce-MyAccount-content {
		@extend .woocommerce-section;

		margin-top: 30px;

		@media (--lg) {
			width: calc(100% - 300px);
			margin-top: 0;
		}

		.content-wrapper,
		.woocommerce-order-downloads {
			@include text-style-text-text-main;

			background: $woo-color-colors-element;
			padding: 40px 30px;

			@media (--sm) {
				padding: 40px 50px;
			}

			&-dashboard {
				p:first-child {
					@include text-style-text-headline-2;

					font-weight: 400;
					margin-bottom: 20px;

					strong {
						font-weight: 600;
					}
				}
			}
		}

		.page-title {
			@include text-style-text-headline-3;

			text-transform: uppercase;
			position: relative;

			&:not(:empty) {
				background: $woo-color-colors-element;
				padding: 23px 50px;
				margin-bottom: 2px;

				&::before {
					content: "";
					position: absolute;
					top: 0;
					left: 0;
					width: 2px;
					height: 100%;
					background: $color-colors-main;
				}
			}

			&:empty {
				margin: 0;
			}
		}

		h3 {
			@include text-style-text-links;

			margin-bottom: 20px;
		}

		.input-text {
			color: $color-text-main;
		}

		.woocommerce-message,
		.woocommerce-info {
			.button:not(.woocommerce-Button) {
				margin-bottom: 10px;

				@media (--sm) {
					margin-bottom: 0;
					margin-right: 10px;
				}
			}
		}

		.woocommerce-message--info,
		.woocommerce-Message--info {
			@include text-style-text-text-main;

			display: flex;
			flex-direction: column-reverse;
			padding: 40px 30px;
			margin: 0;

			@media (--sm) {
				padding: 40px 50px;
			}

			.woocommerce-Button {
				@include btn;

				display: inline-block;
				width: fit-content;
				margin: 20px 0 0;
			}

			&::before,
			&::after {
				display: none;
			}
		}

		.woocommerce-button,
		.button:not(.woocommerce-Button) {
			background: transparent;
			color: $woo-color-colors-main;

			&:--enter {
				background: $woo-color-colors-main;
				border-color: $woo-color-colors-main;
				color: $woo-color-colors-white;
			}
		}

		> .button:last-child {
			display: table;
			margin-top: $woo-main-padding;

			@media (--sm) {
				margin-right: 0;
				margin-left: auto;
			}
		}

		.shop_table_responsive {
			tr {
				display: block;

				&:not(:last-child) {
					border-bottom: 1px solid rgba(219 219 219 / 50%);
					padding-bottom: 15px;
					margin-bottom: 15px;
				}

				&.payment-method {
					border-bottom: 1px solid rgba(219 219 219 / 50%);
					padding-bottom: 15px;
					margin-bottom: 15px;
				}

				th {
					@include text-style-text-links;

					width: 100%;
					padding: 0 10px 20px 0;
					text-align: left;
				}

				td {
					@include text-style-text-text-main;

					width: 100%;
					text-align: left;
					margin-bottom: 5px;

					@media (--less-sm) {
						&.woocommerce-orders-table__cell-order-actions,
						&.download-file,
						&.payment-method-actions {
							padding: 5px 0;

							&::before {
								padding: 5px 0;
							}
						}
					}

					.woocommerce-button,
					.button {
						background: transparent;
						color: $woo-color-colors-main;

						&:--enter {
							background: $woo-color-colors-main;
							border-color: $woo-color-colors-main;
							color: $woo-color-colors-white;
						}
					}

					&:not([class$="-actions"]):not(.download-file)::before {
						content: attr(data-title) ": ";
						font-weight: 600;
						float: left;
						padding-right: 10px;
					}

					&.payment-method-actions {
						display: flex;
						flex-direction: column;
						gap: 10px;
					}
				}
			}

			&.account-orders-table {
				th,
				td {
					&:first-of-type {
						width: 60%;
					}
				}

				td {
					&:first-of-type {
						color: $woo-color-colors-main;
					}
				}
			}

			&.woocommerce-MyAccount-paymentMethods + .button {
				width: 100%;

				@media (--sm) {
					width: auto;
					margin-top: 15px;
				}
			}

			@media (--sm) {
				display: table;
				width: 100%;

				thead {
					display: table-header-group;
				}

				tbody {
					display: table-row-group;
				}

				tr {
					width: 100%;
					display: flex;
					justify-content: space-between;
					align-items: center;

					td,
					th {
						margin-bottom: 0;

						&.woocommerce-orders-table__cell-order-actions,
						&.download-file,
						&.payment-method-actions {
							text-align: right;
						}

						&::before {
							content: none !important;
						}

						&.payment-method-actions {
							max-width: 132px;
						}

						&.payment-method-expires {
							width: 65%;
						}
					}

					th.download-file {
						display: none;
					}

					th.woocommerce-orders-table__header-order-actions {
						visibility: hidden;
					}
				}
			}
		}

		.woocommerce-Address {
			header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 15px;

				h3 {
					@include text-style-text-links;

					margin-bottom: 0;
				}

				a {
					@include text-style-text-links;

					border-bottom: 1px solid $color-colors-main;
				}
			}

			address {
				font-style: normal;
			}

			+ .woocommerce-Address {
				margin-top: $woo-main-padding;
			}
		}

		.woocommerce-address-fields {
			[type="submit"] {
				width: 100%;

				@media (--sm) {
					width: calc(50% - 5px);
					margin-top: 15px;
				}
			}

			p:last-child {
				display: block;
			}
		}

		.woocommerce-EditAccountForm.edit-account {
			> p:last-child {
				width: 100%;
			}

			.form-row {
				padding: 0;
			}

			[type="submit"] {
				width: 100%;
				padding: 0 10px;

				@media (--sm) {
					margin-top: 5px;
				}
			}

			em {
				@include text-style-text-text-3;

				display: inline-block;
				color: $color-colors-89;
				margin-top: 10px;
			}

			fieldset {
				margin: 25px 0 0;

				legend {
					@include text-style-text-links;

					margin-bottom: 20px;
				}
			}
		}

		.woocommerce-order-details,
		.woocommerce-customer-details {
			&:not(:last-child) {
				margin-bottom: 40px;
			}

			h2 {
				@include text-style-text-headline-2;

				margin-bottom: 10px;
			}

			.woocommerce-column {
				&:not(:last-child) {
					margin-bottom: 40px;
				}
			}

			address {
				font-style: normal;
				line-height: 30px;
			}

			p {
				margin: 0;
			}

			.woocommerce-table {
				max-width: 650px;

				tr {
					line-height: 30px;
				}

				th {
					@include text-style-text-links;

					padding: 0;
				}

				td {
					line-height: 30px;

					a {
						font-weight: 500;
						transition: color 0.3s;

						&:--enter {
							color: $color-element-hover;
							text-decoration: none;
						}
					}

					sup {
						font-size: 65%;
						line-height: 1;
					}

					&.product-name {
						@include text-style-text-text-2;
					}
				}
			}

			strong {
				font-weight: 500;
			}
		}

		.payment {
			&_methods {
				fieldset {
					border: none;
					padding: 0;

					label {
						font-weight: 300;
						color: $color-text-main;
						padding: 0;
					}
				}

				.wc-credit-card-form {
					margin: 20px 0;

					.form-row:not(.form-row-last) {
						margin-bottom: 20px;
					}

					label {
						display: block;
						font-size: 14px;
						line-height: 22px;
						padding: 0;
						margin-bottom: 5px;
					}

					.wc-stripe-elements-field {
						@include input;
					}

					.stripe-card-group {
						padding: 0;
					}
				}

				.woocommerce-PaymentBox {
					padding: 0;
				}

				[type="radio"] + label {
					padding-left: 20px;

					&::before {
						left: 0;
					}
				}

				[type="radio"] {
					left: 0;
					top: 6px;
					transform: translate(0);
				}

				p {
					font-weight: 300;
					color: $color-text-main;
				}
			}
		}
	}
}
