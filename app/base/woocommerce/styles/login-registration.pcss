.login-section {
	&.user-is-not-registered {
		max-width: 640px;
		margin: 0 auto;
	}

	&:last-of-type {
		padding-bottom: 110px;
	}

	h1 {
		@include text-style-text-headline-1;

		text-align: center;
		margin-bottom: 30px;
	}

	.guest-checkout {
		padding: 30px;
		background: $woo-color-colors-element;
		text-align: center;
		margin-bottom: 30px;

		h2 {
			@include text-style-text-headline-2;

			text-transform: uppercase;
			margin-bottom: 15px;
		}

		p {
			@include text-style-text-text-2;

			max-width: 340px;
			margin: 0 auto 25px;
		}

		.btn {
			width: 100%;

			@media (--sm) {
				width: auto;
			}
		}
	}

	.separator-or {
		text-align: center;
		margin: 30px 0;

		p {
			@include text-style-text-links;

			line-height: 22px;
			color: $color-text-main;
			text-transform: uppercase;
			margin: 0;
			opacity: 0.6;
		}
	}

	.section-auth {
		&:not(:first-child) {
			margin-top: 30px;
		}

		&:not(:last-child) {
			margin-bottom: 30px;
		}
	}

	.tabs-nav {
		display: flex;
		justify-content: space-between;
		padding: 0;
		margin: 0;
		list-style: none;

		li {
			height: 74px;
			width: calc(50% - 1px);
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 0 10px;
			font-weight: 600;
			font-size: 16px;
			line-height: 24px;
			text-transform: uppercase;
			text-align: center;
			border: 1px solid $woo-color-colors-element;
			cursor: pointer;
			transition: color 0.3s, background 0.3s;

			&.active {
				background: $woo-color-colors-element;
				color: $woo-color-colors-main;
			}

			&:not(.active) {
				background: transparent;
				color: rgba(40, 40, 40, 0.5);

				&:hover {
					background: rgba(246, 246, 246, 0.25);
				}
			}
		}
	}

	.tabs {
		max-width: 100%;
	}

	.tab {
		background: $woo-color-colors-element;
		padding: 40px 30px;

		@media (--sm) {
			padding: 60px 40px;
		}
	}

	.woocommerce-form {
		max-width: 500px;
		margin: 0 auto;

		.form-row-rememberme {
			margin: 31px 0 44px;
		}

		.woocommerce-LostPassword {
			@include woo-link;

			display: inline-block;
			margin-top: 15px;

			@media (--xs) {
				float: right;
				margin: 0;
			}
		}

		&.woocommerce-form-register {
			#password_confirm_field {
				margin-bottom: 30px;
			}

			p:last-child {
				@include text-style-text-text-3;

				text-align: center;
				max-width: 440px;
				margin: 20px auto 0;
			}

			a {
				text-decoration: underline;

				&:--enter {
					text-decoration: none;
				}
			}
		}
	}

	.woocommerce-message + p {
		@include text-style-text-text-main;

		max-width: 850px;
		margin: 20px 0 0 20px;

		@media (--sm) {
			margin: 26px 0 0 48px;
		}
	}

	.woocommerce-ResetPassword {
		@extend .woocommerce-section;

		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 10px;
		background: $woo-color-colors-element;
		padding: 40px 30px;

		&:not(:first-child) {
			margin-top: 21px;
		}

		@media (--lg) {
			padding: 40px 50px;
		}

		p:not(.form-row) {
			@include text-style-text-text-main;

			width: 100%;
			margin-bottom: 20px;

			@media (--less-md) {
				br {
					display: none;
				}
			}

			strong {
				@include text-style-text-links;
			}

			+ .form-row {
				@media (--sm) {
					flex: 1 0 0;
				}
			}
		}

		.form-row {
			width: 100%;
			margin: 0 !important;

			@media (--sm) {
				width: max-content;
			}

			&:first-of-type {
				@media (--sm) {
					flex: 1 0 0;
				}
			}

			&-first,
			&-last {
				width: 100%;

				@media (--sm) {
					flex: 1 0 0;
				}
			}

			.woocommerce-Button {
				width: 100%;

				@media (--xxl) {
					margin-left: 10px;
				}
			}

			> br {
				display: none;
			}
		}

		.clear {
			display: none;
		}
	}
}
