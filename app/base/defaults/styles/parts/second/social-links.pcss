@import "../../../../../src/styles/variables-and-mixins.pcss";

.social-links {
	display: flex;
	justify-content: center;
	flex-wrap: wrap;
	gap: 10px;

	&__link {
		display: inline-block;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		overflow: hidden;
		position: relative;
	}

	&__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	&__text {
		@include screen-reader-text;
	}

	@modifier (outline) {
		&__link:not(:--enter) {
			outline: 1px solid currentcolor;
		}
	}

	@modifier (toggle) {
		&__image {
			transition: opacity 0.3s;

			&_color {
				opacity: 0;
			}

			&_outline {
				position: absolute;
				top: 0;
				left: 0;
				opacity: 1;
			}

			&-bg {
				opacity: 0;
				transition: opacity 0.3s;
			}
		}

		&__link {
			color: currentcolor;

			&:--enter {
				&&__image {
					&-bg,
					&_color {
						opacity: 1;
					}

					&_outline {
						opacity: 0;
					}
				}
			}
		}
	}

	@modifier (color) {
		&__image {
			transition: opacity 0.3s;

			&_outline {
				display: none;
			}
		}

		&__link {
			color: #fff;

			&:--enter {
				&&__image {
					opacity: 0.7;
				}
			}
		}
	}

	@modifier (size, 50) {
		&__link {
			width: 50px;
			height: 50px;
		}
	}

	@modifier (gap, 20) {
		gap: 20px;
	}
}
