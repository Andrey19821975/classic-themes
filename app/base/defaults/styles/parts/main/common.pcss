@import "../../../../../src/styles/variables-and-mixins.pcss";

body {
	font-family: $font-family-global;
	background-color: $color-colors-white;
	color: $color-text-main;
	min-height: 100vh;
	display: flex;
	justify-content: space-between;
	flex-direction: column;
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
}

main {
	flex: 1 0 0;
}

h1,
h2,
h3,
h4,
h5,
h6,
p,
ul,
ol,
figure,
blockquote {
	@include removed-top-button-margins;
}

a {
	color: $color-text-link;
	text-decoration: none;

	&:--enter {
		text-decoration: underline;
	}
}

iframe,
img,
svg,
video {
	max-width: 100%;
	height: auto;
}

button,
[type="submit"],
[type="button"] {
	font-size: 16px;
	cursor: pointer;

	&:disabled {
		@include disabled;
	}
}

dialog {
	max-width: none;
	max-height: none;
	margin: 0;
	padding: 0;
	border: none;
	inset: auto;
	display: block;

	&:not([open]) {
		display: none;
	}
}

[hidden] {
	display: none !important;
}

/* prettier-ignore */
theme-tabs:not([class*="_ready"]) :where(theme-tabs-button, theme-tabs-content):not(:first-of-type) {
	display: none;
}
