<div class="social-links {{class}}">
	<a class="social-links__link" href="#">
		{{svgInline "social-icons/linkedin-color.svg" "social-links__image"}}
		<span class="social-links__text">LinkedIn</span>
	</a>
	<a class="social-links__link" href="#">
		{{svgInline "social-icons/instagram-color.svg" "social-links__image"}}
		<span class="social-links__text">Instagram</span>
	</a>
	<a class="social-links__link" href="#">
		{{svgInline "social-icons/facebook-color.svg" "social-links__image"}}
		<span class="social-links__text">Facebook</span>
	</a>
</div>
