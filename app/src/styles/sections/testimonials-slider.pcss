@import "../variables-and-mixins.pcss";

.testimonials-slider {
	text-align: center;
	padding: 80px 0;
	overflow: hidden;

	@media (--lg) {
		padding: 100px 0;
	}

	&:not(&_bg-white) {
		color: $color-colors-white;
		background: $color-bg-custom;

		&&__summary {
			@media (--less-md) {
				display: none;
			}
		}

		.btn {
			color: $color-colors-main;
			background: $color-colors-white;
			border-color: $color-colors-white;

			&:--enter {
				color: $color-colors-white;
				background: transparent;
			}

			@media (--less-xs) {
				font-size: 16px;
			}
		}
	}

	&_bg-white {
		color: $color-text-second;
		background: $color-colors-white;
	}

	.inner {
		padding: 0;
	}

	&__slider {
		&.tns-slider {
			display: flex;
			justify-content: center;
		}
	}

	&__item {
		&:not(.tns-item) {
			&:not(:first-child) {
				display: none;
			}
		}

		&.tns-item {
			min-height: 100%;
		}
	}

	&__wrapper {
		display: flex;
		flex-direction: column;
		justify-content: center;
		height: 100%;
		max-width: 1070px;
		margin: 0 auto;
		padding: 0 35px;
	}

	&__image {
		margin-bottom: clamp(1.875rem, 1.0625rem + 3.3333vw, 3.75rem);
	}

	&__title {
		font-weight: 700;
		font-size: clamp(1.5rem, 0.85rem + 2.6667vw, 3rem);
		line-height: normal;
		letter-spacing: 0.05em;
		margin-bottom: 20px;

		@media (--md) {
			max-width: 872px;
			margin: 0 auto 30px;
		}
	}

	&__summary {
		font-size: clamp(1.125rem, 0.8542rem + 1.1111vw, 1.75rem);
		line-height: 1.2;
		letter-spacing: 0.05em;
		margin-bottom: clamp(2.5rem, 1.9583rem + 2.2222vw, 3.75rem);
	}

	&__h3 {
		font-weight: 700;
		font-size: clamp(1rem, 0.8375rem + 0.6667vw, 1.375rem);
		line-height: normal;
		letter-spacing: 0.07em;
		margin-bottom: 8px;
	}

	&__p {
		font-size: 18px;
		line-height: normal;
		letter-spacing: 0.06em;
	}

	&__btn {
		margin-top: 60px;
	}

	@include tns-controls;

	.tns {
		&-controls {
			transform: translate(-50%, calc(-50% + 30px));
			padding: 0 10px;

			button {
				color: $color-text-second;
				background: rgba(255, 255, 255, 0.76);

				&:--enter {
					background: $color-colors-white;
				}
			}
		}
	}

	@modifier (bg-white) {
		padding-top: 14px;

		@media (--lg) {
			padding: 14px 0 92px;
		}

		&__image {
			width: 60%;
			max-width: 331px;
			margin: 0 auto 20px;

			@media (--xl) {
				margin-bottom: 27px;
			}
		}

		&__title {
			letter-spacing: 0.07em;
			-webkit-text-stroke-width: 0.3px;
		}

		&__summary {
			margin-bottom: 38px;
		}

		&__h3,
		&__p {
			color: $color-text-grey;
		}

		&__p {
			-webkit-text-stroke-width: 0.2px;
		}

		.tns {
			&-controls {
				button {
					&:--enter {
						color: $color-element-hover;
					}

					@media (--less-md) {
						width: 20px;
						height: 20px;
						padding: 3px;
					}
				}
			}
		}
	}
}
