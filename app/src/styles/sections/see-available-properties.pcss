@import "../variables-and-mixins.pcss";

.see-available-properties {
	.inner {
		padding: 0;
	}

	&__wrapper {
		display: flex;
		flex-wrap: wrap;
		gap: 20px 23px;

		@media (--md) {
			overflow: hidden;
		}
	}

	&__content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		width: 100%;
		min-height: 200px;
		padding: 30px;
		background: $color-colors-element;
		position: relative;
		transition: transform 0.3s ease-in-out;

		@media (--md) {
			width: 33.1%;
			min-height: 375px;

			&:--enter {
				transform: scale(1.11);
			}
		}

		@media (--lg) {
			padding: 30px 60px;
		}
	}

	&__media {
		width: 100%;

		@media (--md) {
			flex: 1 0 0;
		}
	}

	&__img {
		display: block;
		width: 100%;
		min-height: 250px;
		object-fit: cover;

		@media (--md) {
			height: 100%;
			max-height: 376px;
		}
	}

	&__title {
		@include text-style-text-headline-2;

		color: $color-text-second;

		&:not(:last-child) {
			margin-bottom: 30px;
		}

		@media (--md) {
			font-size: clamp(2rem, 1.3333rem + 1.3889vw, 3rem);

			&:not(:last-child) {
				margin-bottom: 40px;
			}
		}
	}

	.btn {
		&::after {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
		}
	}

	&__slider {
		height: 100%;

		&:not(.tns-slider) {
			padding: 0;
		}
	}

	&__item {
		height: 100%;

		&:not(.tns-item) {
			&:not(:first-child) {
				display: none;
			}
		}
	}

	@include tns-controls;

	.tns {
		&-outer,
		&-ovh,
		&-inner,
		&-slider {
			height: 100%;
		}
	}

	@modifier (reverse) {
		&__wrapper {
			@media (--md) {
				flex-direction: row-reverse;
				column-gap: 30px;
			}
		}

		&__content {
			@media (--md) {
				width: 32.77%;
			}
		}
	}

	@modifier (two-image) {
		&__wrapper {
			@media (--xxl) {
				column-gap: 37px;
			}
		}

		&__content {
			@media (--xxl) {
				width: 35.53%;
				min-height: 402px;
			}
		}

		&__media {
			&:last-child:not(&:nth-child(2)) {
				@media (--md) {
					display: none;
				}

				@media (--lg) {
					display: block;
				}
			}
		}

		&__img {
			@media (--xxl) {
				max-height: 402px;
			}
		}

		&__title {
			@media (--xl) {
				max-width: 300px;
				margin: 0 auto 40px;
			}
		}
	}
}
