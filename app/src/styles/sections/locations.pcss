@import "../variables-and-mixins.pcss";

.locations {
	position: relative;

	&__buttons {
		position: absolute;
		top: 10px;
		right: 10px;
		z-index: 1;

		.btn {
			height: 30px;
			font-size: 12px;
			line-height: 30px;
			padding: 0 10px;

			@media (--xs) {
				font-size: 14px;
			}
		}
	}

	&__caption {
		position: absolute;
		bottom: 0;
		right: 0;
		z-index: 1;
		font-size: 14px;
		line-height: normal;
		background: $color-colors-white;
		padding: 10px;

		&-item {
			display: flex;
			align-items: center;
			gap: 8px;

			&:not(:last-child) {
				margin-bottom: 10px;
			}

			svg {
				width: 18px;
				height: 18px;
				flex-shrink: 0;
			}
		}
	}

	&__map {
		min-height: 500px;
	}
}
