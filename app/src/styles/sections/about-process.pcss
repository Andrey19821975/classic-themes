@import "../variables-and-mixins.pcss";

.about-process {
	padding: 80px 0;

	@media (--lg) {
		padding: 100px 0;
	}

	.inner {
		max-width: $max-width-narrow-inner;
	}

	&__wrapper {
		display: grid;
		gap: 30px;

		@media (--md) {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	&__item {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		color: $color-colors-white;
		background: linear-gradient(0deg, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), radial-gradient(50% 50% at 50% 50%, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0) 78.5%);
		padding: 50px 30px 47px;
		position: relative;
		transition: background 0.3s ease-out;

		&:--enter {
			background: linear-gradient(0deg, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), radial-gradient(50% 50% at 50% 50%, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0) 78.5%), rgba(0, 0, 0, 0.2);
		}

		@media (--lg) {
			min-height: 400px;
		}

		.object-fit {
			z-index: -1;
		}
	}

	&__title {
		font-weight: 400;
		font-size: 32px;
		line-height: normal;
		text-wrap: balance;
		margin-bottom: 30px;

		@media (--xs) {
			font-size: clamp(2.5rem, 1.7644rem + 1.5326vw, 3rem);
		}

		@media (--md) {
			max-width: 350px;
			margin-bottom: 40px;
		}
	}

	&__p {
		&:has(.btn) {
			position: unset;
		}
	}

	.btn {
		&::after {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
		}
	}
}
