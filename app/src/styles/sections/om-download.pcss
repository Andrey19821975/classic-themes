@import "../variables-and-mixins.pcss";

.om-download {
	padding: 40px 0;

	@media (--lg) {
		padding-bottom: 60px;
	}

	.title {
		color: $color-text-second;
		text-align: center;
		margin-bottom: 40px;
	}

	&__wrapper {
		max-width: 807px;
		margin: 0 auto;
	}

	.gform {
		&_fields {
			.gfield {
				&--type-text,
				&--type-email {
					@media (--sm) {
						width: calc(50% - 10px);
					}
				}

				&--type-html {
					max-height: 250px;
					font-size: 14px;
					line-height: 1.3;
					color: #777779;
					border: 1px solid #b6c9e3;
					padding: 10px;
					overflow: auto;
					scrollbar-width: thin;
					scrollbar-color: rgba(119, 119, 121, 0.7) transparent;
				}
			}
		}

		&_footer {
			width: 100%;
			margin-top: 20px;

			@media (--xs) {
				width: max-content;
				margin: 20px auto 0;
			}
		}

		&_button {
			width: 100%;
		}
	}
}
