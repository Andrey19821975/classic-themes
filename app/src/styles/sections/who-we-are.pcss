@import "../variables-and-mixins.pcss";

.who-we-are {
	padding: 20px 0;

	@media (--md) {
		max-width: 1920px;
		margin: 0 auto;
		overflow: hidden;
	}

	.inner {
		padding: 0;
	}

	&__wrapper {
		display: flex;
		flex-wrap: wrap-reverse;
		gap: 0 20px;
	}

	&__left {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		gap: 10px;
		width: 100%;
		min-height: 200px;
		padding: 30px;
		background: $color-colors-element;
		position: relative;
		transition: transform 0.3s ease-in-out, padding 0.3s ease-in-out;

		@media (--md) {
			width: 34.4%;
			min-height: 375px;
			transform-origin: right;

			&:--enter {
				transform: scale(1.1);
				padding: 30px 10px 30px 40px;
			}
		}

		&&__a {
			text-decoration: none;

			&:--enter {
				text-decoration: none;
			}

			&::after {
				content: "";
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
			}
		}
	}

	&__right {
		width: 100%;
		padding: 40px;

		@media (--md) {
			flex: 1 0 0;
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding: 50px clamp(1.875rem, -1.125rem + 6.25vw, 6.375rem);
		}
	}

	&__image {
		max-width: 200px;

		@media (--md) {
			max-width: 331px;
		}
	}

	&__title {
		@include text-style-text-headline-2;

		color: $color-text-second;

		@media (--md) {
			font-size: clamp(2rem, 1.3333rem + 1.3889vw, 3rem);
		}
	}

	.title {
		color: $color-text-second;
		margin-bottom: 30px;

		@media (--less-md) {
			text-align: center;
		}
	}

	&__ul {
		list-style: none;
		padding: 0;
		margin: 0;

		@media (--sm) {
			padding-left: 30px;
		}

		&:not(:last-child) {
			margin-bottom: 30px;
		}
	}

	&__li {
		@include text-style-text-text-main;

		padding-left: 17px;
		position: relative;

		&::after {
			content: "";
			position: absolute;
			top: 11px;
			left: 0;
			width: 6px;
			height: 6px;
			border: 2.5px solid $color-text-second;
			border-radius: 50%;
		}

		&:not(:last-child) {
			margin-bottom: 10px;
		}
	}
}
