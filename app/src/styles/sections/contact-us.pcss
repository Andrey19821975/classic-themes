@import "../variables-and-mixins.pcss";

.contact-us {
	padding: 40px 0;

	@media (--lg) {
		padding-bottom: 60px;
	}

	.inner {
		max-width: $max-width-wide-inner;
	}

	&__buttons {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 15px 10px;
		width: 100%;
		background: $color-colors-element;
		border-radius: 10px;
		padding: 20px;
		margin: 0 auto 30px;

		@media (--sm) {
			width: fit-content;
			padding: 8px;
			border-radius: 50px;
			margin-bottom: 40px;
		}

		.btn {
			width: 100%;
			font-size: 16px;
			color: $color-colors-main;
			background: $color-colors-white;
			padding: 14px clamp(1.25rem, 0.3685rem + 2.4876vw, 1.5625rem) 13px;

			@media (--sm) {
				width: auto;
			}

			&:--enter,
			&.active {
				color: $color-colors-white;
				background: $color-colors-main;
				border-color: $color-colors-main;
			}
		}
	}

	&__wrapper {
		display: flex;
		flex-wrap: wrap;
		gap: 40px 30px;

		&:not(:last-child) {
			margin-bottom: 50px;
		}
	}

	&__content {
		width: 100%;

		@media (--md) {
			flex: 1 0 0;
		}
	}

	&__map {
		width: 100%;
		min-height: 400px;

		@media (--md) {
			width: 50%;
			min-height: 500px;
			align-self: flex-start;
			position: sticky !important;
			top: 110px;
		}
	}

	&__description {
		color: $color-text-second;

		&.hidden {
			display: none;
		}

		@media (--md) {
			display: flex;
			flex-direction: column;
			justify-content: center;
			height: 100%;

			&_mobile {
				display: none;
			}
		}

		&_desktop {
			display: none;

			@media (--md) {
				display: flex;
			}
		}

		&&__p {
			font-weight: 700;
			font-size: clamp(1.75rem, 1.1117rem + 1.3298vw, 2.375rem);
			line-height: 1.4;
			letter-spacing: 0.02em;

			&:not(:last-child) {
				margin-bottom: 30px;
			}
		}
	}

	&__item {
		display: none;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
		color: #5a5959;

		&:not(:last-child) {
			margin-bottom: 40px;
		}

		&&__p {
			line-height: normal;

			&:not(:last-child) {
				margin-bottom: 14px;
			}
		}

		> &&__p {
			font-size: clamp(1rem, 0.8723rem + 0.266vw, 1.125rem);
		}
	}

	&__title {
		grid-column: 1/3;
		font-size: clamp(1.625rem, 1.242rem + 0.7979vw, 2rem);
		line-height: 1.3;
		color: $color-text-second;
		margin: 0;
	}

	&__h3 {
		font-weight: 700;
		font-size: clamp(1.25rem, 0.7394rem + 1.0638vw, 1.75rem);
		line-height: normal;
		color: $color-text-second;
		margin-bottom: 20px;
	}

	&__h4 {
		font-weight: 700;
		font-size: clamp(1rem, 0.8723rem + 0.266vw, 1.125rem);
		line-height: normal;
		margin-bottom: 14px;
	}

	&__a {
		color: inherit;
		text-decoration: underline;
		text-decoration-thickness: 0.5px;
		text-underline-offset: 3px;
		transition: color 0.3s;

		&:--enter {
			color: $color-colors-main;
			-webkit-text-stroke-width: 0.2px;
		}
	}

	&__contacts {
		&&__p {
			font-size: clamp(0.875rem, 0.7473rem + 0.266vw, 1rem);
		}
	}

	&__img {
		display: block;
		width: 100%;
		border-radius: 4px;
	}

	@modifier (hide_buttons) {
		&__buttons {
			display: none;
		}

		&__description {
			&&__p:not(.only-for-self-storage) {
				display: none;
			}
		}
	}
}
