@import "../../variables-and-mixins.pcss";

.default-page {
	padding-top: 40px;
	padding-bottom: 60px;

	@media (--lg) {
		padding-bottom: 80px;
	}

	.inner {
		max-width: 1320px;
	}

	&__h1,
	h1 {
		@include text-style-text-headline-1;

		margin-bottom: 30px;
	}

	&__h2 {
		@include text-style-text-headline-3;

		padding-top: 30px;
		margin-bottom: 20px;
	}

	&__h3 {
		@include text-style-text-headline-3;

		padding-top: 30px;
		margin-bottom: 20px;
	}

	&__h4 {
		@include text-style-text-links;

		padding-top: 10px;
		margin-bottom: 15px;
	}

	&__p {
		@include text-style-text-text-2;

		margin-bottom: 15px;
	}

	&__strong {
		font-weight: 400;
		-webkit-text-stroke-width: 0.4px;
	}

	&__u {
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	&__a {
		transition: color 0.3s, -webkit-text-stroke-width 0.3s;

		&:--enter {
			color: $color-element-hover;
			-webkit-text-stroke-width: 0.4px;
			text-decoration: none;
		}
	}

	&__ul {
		list-style: none;
		padding: 0;
		margin: 0;

		&:not(:last-child) {
			margin-bottom: 20px;
		}
	}

	&__li {
		@include text-style-text-text-2;

		padding-left: 16px;
		position: relative;

		&:not(:last-child) {
			margin-bottom: 7px;
		}

		&::after {
			content: "";
			position: absolute;
			top: 9px;
			left: 0;
			width: 6px;
			height: 6px;
			border: 2.5px solid;
			border-radius: 50%;
		}
	}

	ol {
		padding-left: 20px;

		li {
			@include text-style-text-text-2;

			&:not(:last-of-type) {
				margin-bottom: 7px;
			}
		}
	}

	&__table {
		&:not(:last-child) {
			margin-bottom: 30px;
		}
	}

	table,
	th,
	td {
		border: 1px solid $color-colors-light-gray;
		border-collapse: collapse;
	}

	&__td {
		padding: 5px;

		@media (--xs) {
			padding: 10px;
		}
	}
}
