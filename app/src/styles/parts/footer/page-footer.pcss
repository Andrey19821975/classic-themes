@import "../../variables-and-mixins.pcss";

.page-footer {
	padding: 40px 20px;
	color: $color-text-second;

	@media (--lg) {
		padding: 40px 30px;
		max-width: 1920px;
		margin: 0 auto;
	}

	.inner {
		display: grid;
		grid-template-columns: 1fr 150px;
		gap: 40px 20px;
		padding: 0;

		@media (--md) {
			grid-template-columns: 1fr 2.033fr 1fr;
		}

		@media (--xl) {
			grid-template-columns: 1fr 1.377fr 1fr;
			max-width: 1980px;
		}
	}

	&__right {
		display: none;

		@media (--md) {
			display: flex;
			gap: 20px;
		}

		&&__p {
			@media (--md) {
				font-size: 16px;
				line-height: 1.4;
			}

			@media (--lg) {
				line-height: 1.8;
				margin-bottom: 15px;
			}
		}
	}

	&__left {
		@media (--xl) {
			display: flex;
			gap: 20px;
		}
	}

	&__content {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 20px;

		@media (--xl) {
			flex: 1 0 0;
		}

		> &&__p {
			-webkit-text-stroke-width: 0.2px;
			max-width: 290px;
			margin: 0;
		}
	}

	&__image {
		display: none;

		@media (--xl) {
			display: block;
			width: 100%;
			flex: 1 0 0;

			&&__img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
		}
	}

	&__links {
		display: flex;
		flex-direction: column;
		gap: 20px;

		&:not(.hide-on-desktop) {
			@media (--less-md) {
				display: none;
			}
		}
	}

	&__wrapper {
		grid-column: 1/3;
		background: $color-colors-second;
		padding: 25px 15px;

		@media (--md) {
			grid-column: 2;
			padding: 17px 15px;
		}

		.logo {
			max-width: 177px;
			margin: 0 auto;
		}
	}

	&__h3 {
		font-weight: 700;
		font-size: 16px;
		line-height: 1.6;
		letter-spacing: 0.04em;
		margin: 0;

		&:not(:first-child) {
			margin-top: 20px;
		}
	}

	&__p {
		font-size: 13px;
		line-height: 1.2;

		@media (--md) {
			font-size: 15px;
			line-height: 1.5;
		}
	}

	&__a {
		transition: color 0.3s;

		&:--enter {
			color: $color-element-hover;
			text-decoration: none;
		}
	}

	&__ul {
		list-style: none;
		padding: 0;
		margin: 0;

		&:not(:last-child) {
			margin-bottom: 20px;

			@media (--md) {
				margin-bottom: 30px;
			}
		}
	}

	&__li {
		font-size: clamp(0.8125rem, 0.6286rem + 0.3831vw, 0.9375rem);

		&&__a {
			line-height: normal;
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 1px;
		}

		span {
			display: inline-block;
			min-width: clamp(1.4375rem, 1.0697rem + 0.7663vw, 1.6875rem);
			margin-right: clamp(0.3125rem, 0.1042rem + 0.434vw, 0.625rem);
		}
	}

	.social-links {
		color: $color-colors-white;
		justify-content: flex-start;
		gap: 8px;

		&__link {
			background: #676767;
			transition: background 0.3s;

			&:--enter {
				background: transparent;
			}
		}
	}

	.btn {
		font-size: 14px;
		color: $color-colors-main;
		background: transparent;
		padding: 9.2px;
		max-width: 160px;

		@media (--lg) {
			max-width: 200px;
		}

		&:--enter {
			color: $color-colors-white;
			background: $color-colors-main;
			border-color: $color-colors-main;
		}
	}

	.hide-on-desktop {
		@media (--md) {
			display: none;
		}
	}
}
